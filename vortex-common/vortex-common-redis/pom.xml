<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.vortexlab</groupId>
        <artifactId>vortex-common</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <artifactId>vortex-common-redis</artifactId>
    <packaging>war</packaging>

    <dependencies>
        <!--core-->
        <dependency>
            <groupId>com.vortexlab</groupId>
            <artifactId>vortex-common-core</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>

        <!-- redis -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- redis
                为什么不是spring-boot-starter-data-redis
                因为 gateway 是 Spring WebFlux  所以必须用 Reactive Redis 否则会线程阻塞
                -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis-reactive</artifactId>
        </dependency>
    </dependencies>
</project>
